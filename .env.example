# Copiază în .env.local și completează ce ai.

# Baza de date (SQLite local). În producție poate fi un fișier pe server sau Turso (libsql://...).
DATABASE_URL="file:./data/ticketeanu.db"
# DATABASE_AUTH_TOKEN=""

# Secret pentru sesiuni și coduri de login (orice șir lung, aleator).
AUTH_SECRET="schimba-ma-cu-ceva-lung-si-aleator"

# Adresa publică a site-ului (fără slash la final). Folosită în e-mailuri și linkuri.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# E-mail. Fără RESEND_API_KEY, mesajele rămân în outbox și se văd la /dev/emails.
# RESEND_API_KEY=""
MAIL_FROM="Ticketeanu <salut@ticketeanu.ro>"

# Procesator de plăți. "demo" = plată simulată, marcată clar în interfață.
PAYMENT_PROVIDER="demo"

# Comisionul platformei, în sutimi de procent (500 = 5%).
PLATFORM_FEE_BPS="500"

# Secret pentru endpoint-ul de cron (/api/cron/tick).
CRON_SECRET="schimba-ma"
